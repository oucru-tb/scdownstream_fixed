process {
    resourceLimits = [ cpus: 8, memory: 28.GB, time: 48.h ]

    // Pseudobulk DE fails for cell types with no replicate per group (1 Dead patient).
    // Skip those tasks instead of stopping the pipeline.
    withName: '.*:PYDESEQ2_DIFFERENTIAL|.*:EDGEPYTHON_DIFFERENTIAL|.*:EDGEPYTHON_SCDIFFERENTIAL' {
        errorStrategy = 'ignore'
    }
}
executor {
    name   = 'local'
    cpus   = 8
    memory = '28 GB'
}

singularity.pullTimeout = '2h'
